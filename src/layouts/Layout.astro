---
import '../assets/app.css';
import heroImage from '../assets/top/top.jpg';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; width: number; height: number };
}

const { title, description = SITE_DESCRIPTION, image = heroImage } = Astro.props;

const pageTitle = title && title !== SITE_NAME ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="ja" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ec4899" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image.src} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:locale" content="ja_JP" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image.src} />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				try {
					if (localStorage.getItem('vintage') === 'true') {
						root.setAttribute('data-vintage', 'true');
					}
				} catch {}

				try {
					const saved = localStorage.getItem('theme');
					if (saved === 'light' || saved === 'dark') {
						root.setAttribute('data-theme', saved);
						return;
					}
				} catch {}

				const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
				root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
