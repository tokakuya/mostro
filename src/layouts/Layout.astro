---
import '../assets/app.css';

interface Props {
	title?: string;
	description?: string;
}

const SITE_NAME = '桃色CODE';
const DEFAULT_DESCRIPTION = '4コマ漫画「桃色CODE」を無料で読めるビューアーサイトです。';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} - ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="ja" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ec4899" />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:url" content={Astro.url.href} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				try {
					if (localStorage.getItem('vintage') === 'true') {
						root.setAttribute('data-vintage', 'true');
					}
				} catch {}

				try {
					const saved = localStorage.getItem('theme');
					if (saved === 'light' || saved === 'dark') {
						root.setAttribute('data-theme', saved);
						return;
					}
				} catch {}

				const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
				root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
