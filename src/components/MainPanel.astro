---
import ContentColumn from './widget/ContentColumn.astro';
import LatestEpisodeCard from './widget/LatestEpisodeCard.astro';
import { getMangaEpisodes } from '../lib/mangaData';
import { getTopHeroImage } from '../lib/heroImage';

const episodes = getMangaEpisodes();
const hero = getTopHeroImage();
const latest = episodes.at(-1);
---

<ContentColumn>
	<div class="border border-base-300 bg-base-100">
		{
			hero ? (
				<img
					src={hero.src}
					width={hero.width}
					height={hero.height}
					alt="top"
					class="h-auto w-full"
					decoding="async"
					loading="eager"
				/>
			) : (
				<div class="flex aspect-[4/3] w-full items-center justify-center bg-base-200 text-sm opacity-70">
					hero image not found
				</div>
			)
		}
		{
			latest ? (
				<div class="border-t border-base-300 p-3">
					<LatestEpisodeCard
						latest={latest}
						includeTitle
						buttonClass="btn btn-sm btn-primary"
					/>
				</div>
			) : null
		}
	</div>
</ContentColumn>
